{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikipulse.local/schemas/manifest.schema.json",
  "title": "WikiPulse manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "data_through",
    "first_day",
    "last_day",
    "days",
    "counts",
    "files"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "pattern": "^[0-9T:Z-]+$" },
    "data_through": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "first_day": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_day": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "days": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes", "gzip_bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "gzip_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
