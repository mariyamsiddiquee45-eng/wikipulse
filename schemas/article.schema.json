{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikipulse.local/schemas/article.schema.json",
  "title": "WikiPulse article",
  "type": "object",
  "required": [
    "schema_version",
    "article",
    "title",
    "slug",
    "url",
    "description",
    "extract",
    "first_day",
    "last_day",
    "history",
    "spikes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "article": { "type": "string" },
    "title": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "url": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "extract": { "type": ["string", "null"] },
    "first_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["d", "v", "s"],
        "properties": {
          "d": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "v": { "type": "integer", "minimum": 0 },
          "s": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "spikes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "type", "z_score", "score"],
        "properties": {
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "type": { "enum": ["Flash", "Slow burn", "Recurring", "Always-on"] },
          "z_score": { "type": ["number", "null"] },
          "score": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
