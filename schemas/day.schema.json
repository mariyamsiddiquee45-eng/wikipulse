{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikipulse.local/schemas/day.schema.json",
  "title": "WikiPulse day",
  "type": "object",
  "required": ["schema_version", "day", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "score", "type", "members", "extract"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\d{8}-[0-9a-f]{12}$" },
          "label": { "type": "string", "minLength": 1 },
          "score": { "type": "number" },
          "type": { "enum": ["Flash", "Slow burn", "Recurring", "Always-on"] },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "article",
                "title",
                "slug",
                "views",
                "baseline",
                "z_score",
                "class_probability",
                "type",
                "score"
              ],
              "properties": {
                "article": { "type": "string" },
                "title": { "type": "string" },
                "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "views": { "type": "integer", "minimum": 0 },
                "baseline": { "type": ["number", "null"] },
                "z_score": { "type": ["number", "null"] },
                "class_probability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "type": { "enum": ["Flash", "Slow burn", "Recurring", "Always-on"] },
                "score": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "extract": {
            "type": "object",
            "required": ["text", "url", "license"],
            "properties": {
              "text": { "type": ["string", "null"] },
              "url": { "type": "string" },
              "license": { "const": "CC BY-SA 4.0" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
