{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikipulse.local/schemas/search.schema.json",
  "title": "WikiPulse search shard",
  "type": "object",
  "required": ["schema_version", "prefix", "articles"],
  "properties": {
    "schema_version": { "const": 1 },
    "prefix": { "type": "string", "minLength": 1, "maxLength": 2 },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "description", "url", "last_day"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "url": { "type": "string" },
          "last_day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
