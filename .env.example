# Contact address sent in the Wikimedia User-Agent header. Required for live requests.
WIKIPULSE_CONTACT=you@example.com

# Wikimedia API base URLs. Override only for testing or a proxy.
WIKIPULSE_PAGEVIEWS_BASE_URL=https://wikimedia.org/api/rest_v1
WIKIPULSE_SUMMARY_BASE_URL=https://en.wikipedia.org/api/rest_v1

# Minimum delay between sequential Wikimedia requests, in seconds.
WIKIPULSE_REQUEST_DELAY_SECONDS=0.5

# Local data directory. Never commit its contents.
WIKIPULSE_DATA_DIR=./data

# Public site origin used for sitemap and canonical URLs. Empty until a domain exists.
WIKIPULSE_SITE_URL=
